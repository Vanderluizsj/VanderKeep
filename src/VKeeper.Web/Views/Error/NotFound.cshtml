@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <h1 class="display-4 fw-bold text-secondary mb-2">404</h1>
            <h2 class="h4 mb-3">@Model.Title</h2>
            <p class="text-muted mb-4">@Model.Message</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar ao início</a>
        </div>
    </div>
</section>
