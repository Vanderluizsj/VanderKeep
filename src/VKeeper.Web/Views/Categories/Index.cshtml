@model VKeeper.Web.ViewModels.Categories.CategoryListViewModel
@{
    ViewData["Title"] = "Categorias";
}

<section class="py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Categorias</h1>
            <p class="text-muted small mb-0">Organize e filtre suas anotações pessoais por assunto.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Nova categoria</a>
    </div>

    @if (Model.Categories.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <h2 class="h5 fw-semibold mb-2">Nenhuma categoria cadastrada</h2>
                <p class="text-muted mb-4">
                    Crie categorias como Trabalho, Estudos ou Pessoal para organizar suas notas com facilidade.
                </p>
                <a asp-action="Create" class="btn btn-primary">Criar primeira categoria</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Título</th>
                            <th scope="col" class="text-center">Notas vinculadas</th>
                            <th scope="col" class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td class="fw-medium">@category.Title</td>
                                <td class="text-center">
                                    <span class="badge text-bg-secondary rounded-pill">
                                        @category.NoteCount @(category.NoteCount == 1 ? "nota" : "notas")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Ações da categoria @category.Title">
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-primary">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger">Excluir</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
