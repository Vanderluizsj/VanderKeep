@model VKeeper.Web.ViewModels.Categories.EditCategoryViewModel
@{
    ViewData["Title"] = "Editar categoria";
}

<section class="py-3">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 fw-bold mb-1">Editar categoria</h1>
                    <p class="text-muted small mb-4">Altere o título da categoria selecionada.</p>

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" maxlength="50" autofocus />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">Salvar alterações</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
