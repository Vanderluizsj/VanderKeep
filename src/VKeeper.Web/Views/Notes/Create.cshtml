@using VKeeper.Dominio.Enums
@using VKeeper.Web.Servicos
@model VKeeper.Web.ViewModels.Notes.CreateNoteViewModel
@{
    ViewData["Title"] = "Nova nota";
}

<section class="py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 fw-bold mb-1">Nova nota</h1>
                    <p class="text-muted small mb-4">Registre sua anotação, escolha a prioridade e associe categorias se desejar.</p>

                    <form asp-action="Create" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" maxlength="150" autofocus placeholder="Ex.: Resumo de Clean Architecture" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="6" maxlength="5000" placeholder="Detalhes opcionais da nota..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select">
                                @foreach (var priority in Enum.GetValues<NotePriority>())
                                {
                                    <option value="@priority">@NotePriorityDisplay.GetLabel(priority)</option>
                                }
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block">Categorias</label>
                            @if (Model.AvailableCategories.Count == 0)
                            {
                                <p class="text-muted small mb-0">
                                    Você ainda não criou categorias. Você pode salvar esta nota agora ou
                                    <a asp-controller="Categories" asp-action="Create">criar uma categoria</a>.
                                </p>
                            }
                            else
                            {
                                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2">
                                    @foreach (var category in Model.AvailableCategories)
                                    {
                                        var isChecked = Model.SelectedCategoryIds.Contains(category.Id);
                                        <div class="col">
                                            <div class="form-check border rounded p-2 ps-4 bg-light">
                                                <input class="form-check-input" type="checkbox"
                                                       name="SelectedCategoryIds"
                                                       value="@category.Id"
                                                       id="cat_@category.Id"
                                                       checked="@isChecked" />
                                                <label class="form-check-label w-100" for="cat_@category.Id">
                                                    @category.Title
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">Criar nota</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
