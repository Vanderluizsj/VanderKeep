@{
    ViewData["Title"] = "Esvaziar lixeira";
    var trashCount = ViewData["TrashCount"] is int count ? count : 0;
}

<section class="py-3">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 fw-bold text-danger mb-2">Esvaziar lixeira</h1>
                    <p class="mb-3">
                        Tem certeza que deseja excluir permanentemente todas as <strong>@trashCount @(trashCount == 1 ? "nota" : "notas")</strong> da sua lixeira?
                    </p>
                    <div class="alert alert-danger small mb-4" role="alert">
                        Esta ação é irreversível e removerá definitivamente todas as notas que estão na lixeira. Suas notas ativas e arquivadas não serão afetadas.
                    </div>
                    <form asp-action="Empty" method="post">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1">Confirmar e esvaziar lixeira</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
