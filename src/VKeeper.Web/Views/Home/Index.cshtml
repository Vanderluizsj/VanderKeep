@using VKeeper.Aplicacao.Comum
@{
    ViewData["Title"] = "Início";
}

<section class="py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <h1 class="display-6 fw-bold mb-3">VKeeper</h1>
                    <p class="lead text-muted mb-4">
                        Organize suas anotações pessoais por prioridade, categorias, fixação, arquivamento e lixeira com segurança.
                    </p>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var displayName = User.FindFirst(CustomClaimTypes.DisplayName)?.Value
                            ?? User.Identity.Name;
                        <p class="mb-4">
                            Sessão ativa como <strong>@displayName</strong>. Os módulos de categorias, notas e lixeira serão habilitados nas próximas fases.
                        </p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="ChangePassword">Alterar senha</a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a class="btn btn-primary px-4" asp-controller="Account" asp-action="Register">Criar conta</a>
                            <a class="btn btn-outline-secondary px-4" asp-controller="Account" asp-action="Login">Entrar</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
