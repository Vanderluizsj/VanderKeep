@{
    ViewData["Title"] = "Início";
}

<section class="py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <h1 class="display-6 fw-bold mb-3">VKeeper</h1>
                    <p class="lead text-muted mb-4">
                        Organize suas anotações pessoais por prioridade, múltiplas categorias, fixação, arquivamento e lixeira com total privacidade.
                    </p>
                    <p class="text-secondary small mb-4">
                        Acesse sua conta ou cadastre-se gratuitamente para começar a criar e organizar suas notas.
                    </p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a class="btn btn-primary px-4" asp-controller="Account" asp-action="Login">Entrar</a>
                        <a class="btn btn-outline-primary px-4" asp-controller="Account" asp-action="Register">Criar minha conta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
