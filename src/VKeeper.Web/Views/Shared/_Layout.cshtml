@using VKeeper.Aplicacao.Comum
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VKeeper</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">VKeeper</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var isNotesActive = currentController == "Notes" && currentAction != "Archived";
                            var isArchivedActive = currentController == "Notes" && currentAction == "Archived";
                            var isTrashActive = currentController == "Trash";
                            var isCategoriesActive = currentController == "Categories";

                            <li class="nav-item">
                                <a class="nav-link @(isNotesActive ? "active" : "")"
                                   aria-current="@(isNotesActive ? "page" : null)"
                                   asp-controller="Notes" asp-action="Index">Notas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isArchivedActive ? "active" : "")"
                                   aria-current="@(isArchivedActive ? "page" : null)"
                                   asp-controller="Notes" asp-action="Archived">Arquivadas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isTrashActive ? "active" : "")"
                                   aria-current="@(isTrashActive ? "page" : null)"
                                   asp-controller="Trash" asp-action="Index">Lixeira</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isCategoriesActive ? "active" : "")"
                                   aria-current="@(isCategoriesActive ? "page" : null)"
                                   asp-controller="Categories" asp-action="Index">Categorias</a>
                            </li>
                        }
                        else
                        {
                            var isHomeActive = currentController == "Home";
                            <li class="nav-item">
                                <a class="nav-link @(isHomeActive ? "active" : "")"
                                   aria-current="@(isHomeActive ? "page" : null)"
                                   asp-controller="Home" asp-action="Index">Início</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var isChangePasswordActive = currentController == "Account" && currentAction == "ChangePassword";
                            var displayName = User.FindFirst(CustomClaimTypes.DisplayName)?.Value
                                ?? User.Identity.Name
                                ?? "Conta";
                            <li class="nav-item">
                                <span class="navbar-text text-light small me-md-2">Olá, <strong>@displayName</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isChangePasswordActive ? "active" : "")"
                                   aria-current="@(isChangePasswordActive ? "page" : null)"
                                   asp-controller="Account" asp-action="ChangePassword">Alterar senha</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Entrar</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Criar minha conta</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <partial name="_Alerts" />
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white py-3 mt-auto text-muted">
        <div class="container small d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; @DateTime.UtcNow.Year - VKeeper</span>
            <span>Gerenciamento de anotações pessoais</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
